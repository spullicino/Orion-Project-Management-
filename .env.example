# ---------------------------------------------------------------------------
# Orion Projects — environment variables
# Copy this file to `.env.local` for local development. On Vercel, add the same
# names under Project → Settings → Environment Variables. NEVER commit real values.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" key (older projects call it the "anon" key). Safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# The "secret" key (older projects: "service_role"). SERVER ONLY — keep it private.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# The public web address of the app, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://projects.oriongroup.com.mt

# First-time setup: the first person to sign in with this email becomes the
# Administrator. Ignored once an Administrator exists.
BOOTSTRAP_ADMIN_EMAIL=you@oriongroup.com.mt

# Only for the local Supabase CLI (supabase/config.toml) — Google sign-in on localhost.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
